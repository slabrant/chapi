# Copy to /etc/chapi/chapi.env, fill in the password, and chmod 600.
#
# Only the settings a real deployment usually changes are listed. Everything
# else has a default that suits ten to twenty people; see README.md for the
# full set.

# The shared password. There is nothing else standing between the internet and
# the room, so make it long.
CHAPI_PASSWORD=

# Loopback only: Caddy is the way in.
CHAPI_ADDR=127.0.0.1:8080

# Matches StateDirectory in chapi.service. Holds the room archives and, unless
# you supply them yourself, the generated signing key and token secret.
CHAPI_DATA_DIR=/var/lib/chapi

# Safe only because the server is unreachable except through Caddy, which
# overwrites X-Forwarded-For.
CHAPI_TRUST_PROXY_HEADER=true

# Bump to invalidate every outstanding token at once. This is what makes a
# password rotation actually evict people, including those already connected.
CHAPI_TOKEN_EPOCH=1

# Keep this in hours. A stateless token cannot be revoked individually, so
# expiry is the only per-token bound there is.
CHAPI_TOKEN_TTL=12h

# Ceiling on an encoded image payload, advertised to clients at login.
CHAPI_IMAGE_MAX_BYTES=2MiB
